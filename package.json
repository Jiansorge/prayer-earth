{
  "name": "prayer-earth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A quiet place where the whole world prays together.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-legal.mjs && vite build && node scripts/inline-css.mjs",
    "build:legal": "node scripts/build-legal.mjs",
    "build:capacitor": "node scripts/build-legal.mjs && vite build --mode capacitor && node scripts/inline-css.mjs",
    "cap:sync": "npm run build:capacitor && npx cap sync",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node scripts/start-all.mjs",
    "audio": "node scripts/generate-audio.mjs",
    "audio:remove": "node scripts/remove-audio.mjs",
    "serve": "npm run build && node server/index.js",
    "deploy": "node ../sync-engine/scripts/deploy-app.mjs",
    "deploy:dry": "node ../sync-engine/scripts/deploy-app.mjs --dry-run",
    "test": "node scripts/test-server.mjs && node scripts/test-usage.mjs",
    "test:ci": "node scripts/test-usage-ci.mjs",
    "test:android:assets": "node scripts/test-android-assets.mjs",
    "test:android": "node scripts/test-android-device.mjs",
    "test:proof": "node scripts/test-proof.mjs",
    "test:proof2": "node scripts/test-proof-multi.mjs",
    "test:prod": "node scripts/test-prod.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:earth": "node scripts/test-earth.mjs",
    "capture:demo": "node scripts/capture-demo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "gif-encoder-2": "^1.0.5",
    "msedge-tts": "^2.0.7",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "vite": "^8.3.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.4",
    "tar": "^7.5.22",
    "toml": "^4.2.0",
    "uuid": "^11.1.1"
  }
}
