<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: the share/QR links (https://joining-palms.app/#/pray/...).
                 autoVerify makes the association silent and chooser-free, but it is
                 LOAD-BEARING: at install time Android fetches
                   https://joining-palms.app/.well-known/assetlinks.json
                 and, unless it lists this package plus the signing cert's SHA-256,
                 the filter does not associate at all (links fall back to the
                 browser with no chooser - there is no silent half-state). The
                 hosted file must therefore list EVERY key that signs a real
                 install (both are in place as of 2026-10-31):
                   - upload/local key (builds from this machine)
                   - Play's app-signing key (Play installs) - from Play Console
                     > Setup > App integrity; assetlinks supports several
                     identities in one file.
                 If a key ever rotates, update the hosted file BEFORE shipping
                 the new build.
                 pathPattern="/" claims ONLY the root path: the fragment (where
                 the real #/pray/... route lives) is not part of the intent path,
                 so every share/QR link still matches, while real files like
                 /privacy.html and /terms.html keep opening in the browser
                 instead of being hijacked into the app's home view. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="joining-palms.app" android:pathPattern="/" />
            </intent-filter>
        </activity>

        <!-- Baseline profiles: lets the macrobenchmark (:benchmark) trace this
             app's RELEASE build, which is not debuggable. Shell-only - it grants
             no interactive access, and Play accepts it (it is how Play's own
             profiling of production installs works). Ignore-on-older-devices;
             tools:targetApi silences the pre-Android 10 lint. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- The prayer keeps speaking while the app is in the background: the
             WebView plays through the system mixer, and Android 17's background
             audio hardening only allows that while a visible activity exists or
             a mediaPlayback foreground service runs. speech.js brackets the
             life of a prayer job with startPlayback()/stopPlayback() on
             PrayerAudioPlugin, which runs this service. Without it the system
             mutes the app's stream (CONTROL_AUDIO app op) seconds after
             minimize - heard as the ambient bed cutting out. -->
        <service
            android:name=".PrayerPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground services for the prayer's background audio: Android 17
         mutes backgrounded playback without a mediaPlayback service (see the
         .PrayerPlaybackService declaration below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Coarse location places your light on the Earth; precise is optional.
         Capacitor's WebView bridge requests both, and graceful-degrades to
         coarse-only on Android 12+. The app never sends precise coordinates:
         client.js rounds to one decimal and the server stores ~110km cells. -->
    <!-- Location is used only to anchor your light on the map, and the app asks
         for a COARSE fix: sync/client.js sets enableHighAccuracy:false and rounds
         to 0.1 degrees (~11km) before anything is sent, and the server only ever
         receives a 1-degree grid cell. ACCESS_FINE_LOCATION was removed because
         the app has no use for a precise fix - requesting it would have asked
         users for more than we use and misstated the Play data-safety form.
         If permission is refused, sync/client.js falls back to the centre of the
         device's timezone, so a prayer is never lost. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
