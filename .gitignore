node_modules/
dist/
server/data.json
server/data-test.json
server/people.json
server/people-test.json

# local secrets / config
.env
.env.*
!.env.example
!.env.capacitor

# Android release signing (never commit the upload key or its passwords)
android/key.properties
*.jks
*.keystore

# Generated store legal pages (rebuilt from src/locales at build time)
public/privacy.html
public/terms.html
public/delete-data.html

# Godot import artifacts (accidentally copied in from the healing game)
*.import

# local QA captures
qa-shots/
dev-server.log

# aider (local pair-programming tool) artifacts
.aider*
.aider.tags.cache.v4/

# Capacitor generated web content (regenerated by `npx cap sync`)
ios/App/public/
android/app/src/main/assets/public/

# transient local logs from the dev server / device tests
scripts/_*.log
scripts/_*.err

# Generated store-listing art (rebuild with: node scripts/build-feature-graphic.mjs)
dist-store/

# Local scratch: generated screenshots and icon experiments. Only the curated
# store art under public/ is tracked, so everything else is ignored by default
# rather than relying on each being remembered.
*.png
!public/icons/*.png
!public/og-card.png
!public/kofi6.png
!public/land-mask.png
!public/screenshot.png
*.pnm
build-debug.log
