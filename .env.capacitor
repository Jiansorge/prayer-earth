# Capacitor build: connects to the live Cloudflare Worker backend.
# The native WebView origin (capacitor://localhost) would otherwise
# cause the auto-detected WS URL to point at localhost instead.
VITE_SYNC_ENGINE=cf
VITE_SYNC_URL=wss://joining-palms.app

# Test-observability hooks for the on-device smoke test. REMOVE this line (or set
# VITE_TEST_HOOKS=false) when building the PUBLIC Play release. See RELEASE.md.
VITE_TEST_HOOKS=true
